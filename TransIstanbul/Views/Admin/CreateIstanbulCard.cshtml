@model TransIstanbul.AddClasses.IstanbulCard
<div class="app-content content">
    <div class="content-overlay"></div>
    <div class="header-navbar-shadow"></div>
    <div class="content-wrapper">

        <div class="content-body">
            <!-- Basic Horizontal form layout section start -->
            <section id="basic-horizontal-layouts">
                <div class="row match-height">
                    <div class="col-md-12 col-12">
                        <div class="card" style=" background-color: rgba(255,255,255, 0.4) !important;">
                            <div class="card-header">
                                <h4 class="card-title"><span style="font-weight: bolder;color: #cf3e3c">Istanbul Card</span></h4>
                            </div>
                            <div class="card-content">
                                <div class="card-body">
                                    <form class="form form-horizontal" method="post" role="form" asp-controller="Admin" asp-action="CreateIstanbulCard">
                                        <div class="form-body">
                                            <div class="row">
                                                <div class="col-12">
                                                    <div class="form-group row">
                                                        <div class="col-md-2">
                                                            <span style="font-weight:bolder">Customer Type</span>
                                                        </div>
                                                        <div class="col-md-8">
                                                            <select class="form-control" asp-for="CustomerType" style=" background-color: rgba(255,255,255, 0.5) !important;">
                                                                <option value="Fullfare">Full Fare</option>
                                                                <option value="Teacher">Teacher</option>
                                                                <option value="Student">Student</option>

                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>


                                                <div class="col-12">
                                                    <div class="form-group row">
                                                        <div class="col-md-2">
                                                            <span style="font-weight:bolder">Customer Name</span>
                                                        </div>
                                                        <div class="col-md-8">
                                                            <input type="text" asp-for="CustomerName" class="form-control" placeholder="Enter customer name" style=" background-color: rgba(255,255,255, 0.4) !important;">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-12">
                                                    <div class="form-group row">
                                                        <div class="col-md-2">
                                                            <span style="font-weight:bolder">Customer Id</span>
                                                        </div>
                                                        <div class="col-md-8">
                                                            <input type="text" asp-for="CustomerId" class="form-control" placeholder="Enter the customer ID" style=" background-color: rgba(255,255,255, 0.4) !important;">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-12">
                                                    <div class="form-group row">
                                                        <div class="col-md-2">
                                                            <span style="font-weight:bolder">Card Id</span>
                                                        </div>
                                                        <div class="col-md-8">
                                                            <input type="text" asp-for="CardId" class="form-control" placeholder="Enter the card ID" style=" background-color: rgba(255,255,255, 0.4) !important;">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-12">
                                                    <div class="form-group row">
                                                        <div class="col-md-2">
                                                            <span style="font-weight:bolder">Balance</span>
                                                        </div>
                                                        <div class="col-md-8">
                                                            <input type="number" asp-for="Balance" class="form-control" placeholder="Enter Loaded Money to the Card" style=" background-color: rgba(255,255,255, 0.4) !important;">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-8 offset-md-4">
                                                    <a class="btn btn-primary mr-1 mb-1" asp-controller="Admin" asp-action="Index">Back to Home page</a>

                                                    <button type="submit" class="btn btn-primary mr-1 mb-1">Add</button>
                                                    @*<button type="reset" class="btn btn-outline-warning mr-1 mb-1">Reset</button>*@
                                                </div>

                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
        </div>

    </div>
 
</div>
