                    </h3>
                    <h1 class="mb-5">Blue <br />Card</h1>
                    <h3 class="card-text">In Istanbul for all times</h3>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4 stretch-card grid-margin">
        <div class="card bg-gradient-warning card-img-holder text-white">
            <div class="card-body">
                <a asp-controller="Admin" asp-action="CreateElectronicCard">
